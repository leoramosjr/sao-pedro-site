---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
interface Props {
	title: string;
	description?: string;
}
const { title, description = 'Conheça a Paróquia São Pedro, seus horários, sacramentos e comunidade.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			const legacyPageRoutes = {
				'1294': '/paroquia/',
				'1295': '/sacramentos/',
				'1612': '/sacramentos/matrimonio/',
				'1625': '/pastorais/',
				'1674': '/pastorais/dizimo/',
				'1677': '/pastorais/coral/',
				'1679': '/pastorais/rosario-vivo/',
				'1681': '/pastorais/pascom/',
				'1683': '/pastorais/liturgia/',
				'1685': '/pastorais/mcj/',
				'1687': '/movimentos/onda/',
				'1706': '/pastorais/clj/',
				'1721': '/sacramentos/batismo/',
				'1726': '/sacramentos/eucaristia/',
				'1731': '/sacramentos/crisma/',
			};
			const legacyPageId = new URLSearchParams(window.location.search).get('page_id');
			if (legacyPageId && legacyPageRoutes[legacyPageId]) {
				window.location.replace(legacyPageRoutes[legacyPageId]);
			}

			const savedTheme = localStorage.getItem('sao-pedro-theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.dataset.theme = savedTheme === 'light' || savedTheme === 'dark'
				? savedTheme
				: prefersDark ? 'dark' : 'light';
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f6f1" />
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
		<link rel="preload" href="/fonts/Quattrocento-Bold.ttf" as="font" type="font/ttf" crossorigin />
		{Astro.url.pathname === '/' && <>
			<link rel="preload" href="/fonts/Quattrocento-Regular.ttf" as="font" type="font/ttf" crossorigin />
		</>}
		<title>{title} | Paróquia São Pedro</title>
	</head>
	<body>
		<SiteHeader />
		<main id="conteudo"><slot /></main>
		<SiteFooter />
	</body>
</html>
