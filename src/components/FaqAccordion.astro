---
interface FaqItem {
	question: string;
	answer: string[];
}

interface Props {
	title?: string;
	items: FaqItem[];
}

const { title = 'Perguntas frequentes', items } = Astro.props;

---

<section class="faq-section" aria-labelledby="faq-title">
	<h2 id="faq-title">{title}</h2>
	<div class="faq-list">
		{items.map((item) => (
			<details class="faq-item">
				<summary>{item.question}</summary>
				<div class="faq-answer">
					{item.answer.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</details>
		))}
	</div>
</section>
