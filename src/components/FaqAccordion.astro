---
interface FaqItem {
	question: string;
	answer: string[];
}

interface Props {
	title?: string;
	items: FaqItem[];
}

const { title = 'Perguntas frequentes', items } = Astro.props;

---

<section class="faq-section" aria-labelledby="faq-title">
	<h2 id="faq-title">{title}</h2>
	<div class="faq-list">
		{items.map((item) => (
			<details class="faq-item">
				<summary>{item.question}</summary>
				<div class="faq-answer">
					{item.answer.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</details>
		))}
	</div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((item) => {
    const summary = item.querySelector('summary');
    if (!summary) return;
    let animation: Animation | undefined;
    let expanded = item.open;

    summary.addEventListener('click', (event) => {
      event.preventDefault();
      const startHeight = item.getBoundingClientRect().height;
      expanded = !expanded;
      animation?.cancel();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        item.open = expanded;
        return;
      }
      item.open = true;
      const endHeight = expanded ? item.scrollHeight : summary.offsetHeight;
      animation = item.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        { duration: 260, easing: 'ease-in-out' },
      );
      animation.onfinish = () => {
        item.open = expanded;
        animation = undefined;
      };
    });
  });
</script>
