---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CommunityCard from '../../components/CommunityCard.astro';
import { pastorals } from '../../data/site';
---
<BaseLayout title="Pastorais">
	<PageIntro eyebrow="Vida em comunidade" title="Pastorais" description="A comunidade cresce com a participação de pessoas que colocam seus dons a serviço. Conheça as pastorais e ministérios da Paróquia São Pedro." />
	<section class="content-section"><div class="container card-grid">
		{ pastorals.map((item) => <CommunityCard item={item} linkLabel="Conheça o grupo" />) }
		<div class="card"><p class="card-kicker">Vida em comunidade</p><h3>Conheça os movimentos</h3><p>ONDA, CLJ e MCJ reúnem pessoas em diferentes momentos da vida para crescer na fé e servir.</p><a class="text-link" href="/movimentos/">Ver movimentos <span aria-hidden="true">→</span></a></div>
	</div></section>
</BaseLayout>
