---
import BaseLayout from '../layouts/BaseLayout.astro';
import { communities, massSchedule, parish, sacraments } from '../data/site';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/sp_hero.png';
import interiorImage from '../assets/images/interior.jpg';
---

<BaseLayout title="Início" description="Conheça a Paróquia São Pedro, confira os horários de missa e encontre informações sobre sacramentos e comunidade.">
	<section class="hero">
		<Image src={heroImage} alt="" class="hero-image" loading="eager" fetchpriority="high" />
		<div class="container hero-grid">
			<div class="hero-content">
				<div class="hero-heading">
					<p class="eyebrow">Uma comunidade de fé</p>
					<h1>Paróquia São Pedro<span class="hero-subtitle">Porto Alegre</span></h1>
					<p class="hero-address">Av. Cristóvão Colombo, 1629 - Floresta, Porto Alegre - RS, 90560-025</p>
				</div>
				<div class="hero-schedule" aria-label="Horários de missa">
					<a class="button hero-schedule-cta" href="/paroquia/">Conheça a paróquia <span aria-hidden="true">→</span></a>
					<div class="hero-schedule-details">
						<p class="hero-schedule-title">Horários das missas:</p>
						{massSchedule.map((schedule) => <p><span>{schedule.day}</span><strong>{schedule.times}</strong></p>)}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="sacraments-title">
		<div class="container">
			<div class="section-heading">
				<div><p class="eyebrow">Vida sacramental</p><h2 id="sacraments-title">Caminhos de fé para cada etapa da vida</h2><p>Encontre orientações para os sacramentos e saiba como iniciar cada preparação.</p></div>
				<a class="text-link" href="/sacramentos/">Todos os sacramentos <span aria-hidden="true">→</span></a>
			</div>
			<div class="card-grid">
				{ sacraments.slice(0, 4).map((item) => <a class="card" href={item.href}><p class="card-kicker">Sacramento</p><h3>{item.title}</h3><p>{item.description}</p><span class="text-link">Saiba mais <span aria-hidden="true">→</span></span></a>) }
			</div>
		</div>
	</section>

	<section class="section-tight">
		<div class="container story-panel">
			<Image src={interiorImage} alt="Interior da igreja da Paróquia São Pedro." class="story-image" loading="lazy" />
			<div class="story-copy">
				<p class="eyebrow">Nossa história</p>
				<h2>Uma comunidade construída ao longo de gerações.</h2>
				<p>A origem da capelinha de São Pedro remonta a 1887, quando Eduardo Azevedo de Souza Filho doou o terreno e uma imagem do santo para a comunidade.</p>
				<a class="text-link" href="/paroquia/historia/">Conheça a história <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="community-title">
		<div class="container">
			<div class="section-heading">
				<div><p class="eyebrow">Vida em comunidade</p><h2 id="community-title">Há muitas formas de participar</h2><p>Conheça alguns grupos e serviços que ajudam a animar a vida da paróquia.</p></div>
				<a class="text-link" href="/pastorais/">Ver pastorais e movimentos <span aria-hidden="true">→</span></a>
			</div>
			<div class="card-grid">
				{ communities.map((item) => <a class="card" href={item.href}><p class="card-kicker">Comunidade</p><h3>{item.title}</h3><p>{item.description}</p><span class="text-link">Conheça <span aria-hidden="true">→</span></span></a>) }
			</div>
		</div>
	</section>

	<section class="section-tight">
		<div class="container tithe-panel">
			<div><p class="eyebrow">Partilha e missão</p><h2>Seja dizimista. Participe com amor.</h2><p>O dízimo ajuda a sustentar as atividades pastorais, celebrativas e caritativas da paróquia. Para saber como participar, converse conosco após a missa ou entre em contato com a secretaria.</p></div>
			<a class="button" href={parish.whatsappHref} target="_blank" rel="noreferrer">Fale com a secretaria <span aria-hidden="true">→</span></a>
		</div>
	</section>
</BaseLayout>
