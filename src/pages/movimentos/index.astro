---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CommunityCard from '../../components/CommunityCard.astro';
import { movements } from '../../data/site';
---
<BaseLayout title="Movimentos">
	<PageIntro eyebrow="Vida em comunidade" title="Movimentos" description="Conheça os movimentos da Paróquia São Pedro e encontre um espaço para partilhar a fé, formar vínculos e participar da comunidade." />
	<section class="content-section"><div class="container card-grid">
		{ movements.map((item) => <CommunityCard item={item} linkLabel="Conheça o movimento" />) }
		<div class="card"><p class="card-kicker">Participe</p><h3>Quer saber mais?</h3><p>A secretaria paroquial pode ajudar você a conhecer os grupos e seus próximos encontros.</p><a class="text-link" href="/contato/">Fale conosco <span aria-hidden="true">→</span></a></div>
	</div></section>
</BaseLayout>
